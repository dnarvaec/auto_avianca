{
  "name": "auto-avianca",
  "version": "1.0.0",
  "description": "Framework de automatización Avianca — Playwright + TypeScript + DDT + POM",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:nbf": "playwright test tests/nbf/nbf.spec.ts",
    "test:nbf:ow": "playwright test tests/nbf/nbf.spec.ts --grep \"One Way\"",
    "test:nbf:rt": "playwright test tests/nbf/nbf.spec.ts --grep \"Round Trip\"",
    "test:ssci": "playwright test tests/ssci/ssci.spec.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
